@inherits ExampleBase
@using Flow.Diagrams.Algorithms
@attribute [Example("reconnect-to-closest-ports", "Reconnect to closest ports", ExampleCategory.Links,
    "ReconnectLinksToClosestPorts moves each link's ends to the nearest pair of ports of its two nodes. Drag the nodes about, then reconnect.",
    Order = 6)]

<div class="example-column">
    <ExampleToolbar>
        <button @onclick="Diagram.ReconnectLinksToClosestPorts">Reconnect links</button>
    </ExampleToolbar>
    <ExampleCanvas Diagram="Diagram" />
</div>

@code {
    protected override void OnInitialized()
    {
        var a = Node(60, 60, "A");
        var b = Node(460, 300, "B");
        var c = Node(460, 40, "C");

        Link(a, PortAlignment.Top, b, PortAlignment.Right);
        Link(a, PortAlignment.Bottom, c, PortAlignment.Top);
    }

    private void Link(NodeModel from, PortAlignment fromSide, NodeModel to, PortAlignment toSide) =>
        Diagram.Links.Add(new LinkModel(from.GetPort(fromSide)!, to.GetPort(toSide)!) { TargetMarker = LinkMarker.Arrow });

    private NodeModel Node(double x, double y, string title)
    {
        var node = Diagram.Nodes.Add(new NodeModel(new Point(x, y)) { Title = title });
        foreach (var alignment in new[] { PortAlignment.Top, PortAlignment.Right, PortAlignment.Bottom, PortAlignment.Left })
            node.AddPort(alignment);
        return node;
    }
}
