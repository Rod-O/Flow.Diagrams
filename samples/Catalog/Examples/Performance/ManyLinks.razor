@inherits ExampleBase
@attribute [Example("many-links", "Many links", ExampleCategory.Performance,
    "Forty-eight nodes on a ring with hundreds of straight links among them. Change the number of links and drag a node: every link that touches it follows.",
    Order = 2)]

<div class="example-column">
    <ExampleToolbar>
        <label>Links
            <select @onchange="OnCountChanged">
                @foreach (var count in new[] { 100, 300, 600, 900 })
                {
                    <option value="@count" selected="@(count == _linkCount)">@count</option>
                }
            </select>
        </label>
        <span class="dim">@Diagram.Nodes.Count nodes, @Diagram.Links.Count links</span>
    </ExampleToolbar>
    <ExampleCanvas Diagram="Diagram" />
</div>

@code {
    private const int NodeCount = 48;
    private int _linkCount = 300;

    protected override void OnInitialized()
    {
        Diagram.RegisterComponent<ManyLinksNode, ManyLinksWidget>();
        Diagram.Options.Links.DefaultPathGenerator = new StraightPathGenerator();

        for (var i = 0; i < NodeCount; i++)
        {
            var angle = 2 * Math.PI * i / NodeCount;
            Diagram.Nodes.Add(new ManyLinksNode(new Point(380 * Math.Cos(angle), 380 * Math.Sin(angle)), i + 1));
        }

        Connect();
    }

    private void Connect()
    {
        Diagram.Links.Clear();

        var random = new Random(11);
        var seen = new HashSet<(int, int)>();
        while (seen.Count < _linkCount)
        {
            var (a, b) = (random.Next(NodeCount), random.Next(NodeCount));
            if (a != b && seen.Add((Math.Min(a, b), Math.Max(a, b))))
                Diagram.Links.Add(new LinkModel(Diagram.Nodes[a], Diagram.Nodes[b]) { Color = "rgba(31, 111, 178, .3)", Width = 1 });
        }
    }

    private void OnCountChanged(ChangeEventArgs e)
    {
        _linkCount = int.Parse(e.Value!.ToString()!);
        Connect();
    }
}
