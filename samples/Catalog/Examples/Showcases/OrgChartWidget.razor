@{
    var (w, h) = (Node.Size!.Width, Node.Size.Height);
}

<rect x="1" y="1" width="@(w - 2)" height="@(h - 2)" rx="8" fill="#ffffff" stroke="@(Node.Selected ? "#6e9a1e" : "#c7cdcb")" stroke-width="2" />
<path d="M9,1 H12 V@(h - 1) H9 A8,8 0 0 1 1,@(h - 9) V9 A8,8 0 0 1 9,1 Z" fill="@Node.Color" />
<g>
    <text x="26" y="24" font-size="13" font-weight="600" fill="#1e2326">@Node.Name</text>
    <text x="26" y="42" font-size="11" fill="#5f676b">@Node.Role</text>
</g>

@foreach (var port in Node.Ports)
{
    <PortRenderer @key="port" Port="port">
        <circle cx="@(w / 2)" cy="@(port.Alignment == PortAlignment.Top ? 0 : h)" r="1.5" fill="transparent" />
    </PortRenderer>
}

@code {
    [Parameter] public OrgChartNode Node { get; set; } = null!;
}
