@{
    var (w, h) = (Node.Size!.Width, Node.Size.Height);
    var stroke = Node.Selected ? "#6e9a1e" : "#38474d";
}

@switch (Node.Kind)
{
    case StateKind.Initial:
        <circle cx="@(w / 2)" cy="@(h / 2)" r="@(w / 2)" fill="@stroke" />
        break;
    case StateKind.Final:
        <circle cx="@(w / 2)" cy="@(h / 2)" r="@(w / 2 - 1)" fill="#ffffff" stroke="@stroke" stroke-width="2" />
        <circle cx="@(w / 2)" cy="@(h / 2)" r="@(w / 2 - 6)" fill="@stroke" />
        break;
    default:
        <rect x="1" y="1" width="@(w - 2)" height="@(h - 2)" rx="14" fill="#e3f0fb" stroke="@stroke" stroke-width="2" />
        <g>
            <text x="@(w / 2)" y="@(Node.Action == null ? h / 2 : 23)" text-anchor="middle" dominant-baseline="central" font-size="14" font-weight="600" fill="#1e2326">@Node.Name</text>
            <text x="@(w / 2)" y="40" text-anchor="middle" dominant-baseline="central" font-size="11" fill="#5f676b">@Node.Action</text>
        </g>
        break;
}

@foreach (var port in Node.Ports)
{
    var (cx, cy) = port.Alignment switch
    {
        PortAlignment.Top => (w / 2, 0.0),
        PortAlignment.TopLeft => (w * 0.25, 0.0),
        PortAlignment.TopRight => (w * 0.75, 0.0),
        PortAlignment.Right => (w, h / 2),
        PortAlignment.Bottom => (w / 2, h),
        _ => (0.0, h / 2),
    };
    <PortRenderer @key="port" Port="port">
        <circle cx="@cx" cy="@cy" r="1.5" fill="transparent" />
    </PortRenderer>
}

@code {
    [Parameter] public StateMachineNode Node { get; set; } = null!;
}
