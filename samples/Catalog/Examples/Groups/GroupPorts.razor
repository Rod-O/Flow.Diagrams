@inherits ExampleBase
@attribute [Example("group-ports", "Group ports", ExampleCategory.Groups,
    "A group can have ports of its own, and links attach to them like to any node's. The group's size follows its child, and so do its ports. Drag the only child: the group moves, and its ports and links with it.", Order = 4, New = true)]

<ExampleCanvas Diagram="Diagram" />

<style>
    div.diagram-group.default { outline: 2px dashed #9bb86a; border-radius: 12px; background: rgba(110, 154, 30, .08); }
    div.diagram-group.default.selected { outline-color: #6e9a1e; }
</style>

@code {
    protected override void OnInitialized()
    {
        Diagram.Options.Links.DefaultRouter = new OrthogonalRouter();
        Diagram.Options.Links.DefaultPathGenerator = new StraightPathGenerator(radius: 6);

        var inlet = Node(60, 160, "Inlet");
        var outlet = Node(700, 160, "Outlet");
        var mixer = Node(360, 160, "Mixer");

        var group = new GroupModel([mixer], new GroupPadding(40, 40, 40, 40)) { Title = "Mixing unit" };
        var left = group.AddPort(PortAlignment.Left);
        var right = group.AddPort(PortAlignment.Right);
        Diagram.Groups.Add(group);

        Diagram.Links.Add(new LinkModel(inlet.GetPort(PortAlignment.Right)!, left) { TargetMarker = LinkMarker.Arrow });
        Diagram.Links.Add(new LinkModel(right, outlet.GetPort(PortAlignment.Left)!) { TargetMarker = LinkMarker.Arrow });
    }

    private NodeModel Node(double x, double y, string title)
    {
        var node = Diagram.Nodes.Add(new NodeModel(new Point(x, y)) { Title = title });
        foreach (var alignment in new[] { PortAlignment.Top, PortAlignment.Right, PortAlignment.Bottom, PortAlignment.Left })
            node.AddPort(alignment);
        return node;
    }
}
