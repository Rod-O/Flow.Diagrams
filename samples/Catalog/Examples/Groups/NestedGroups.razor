@inherits ExampleBase
@attribute [Example("nested-groups", "Nested groups", ExampleCategory.Groups,
    "A group can be a child of another group. Drag a node: its group grows to follow it, and the outer group follows the inner one. Drag an inner group to move it inside the outer one.", Order = 5)]

<ExampleCanvas Diagram="Diagram" />

<style>
    div.diagram-group.default { outline: 2px dashed #9bb86a; border-radius: 12px; background: rgba(110, 154, 30, .08); }
    div.diagram-group.default.selected { outline-color: #6e9a1e; }
</style>

@code {
    protected override void OnInitialized()
    {
        var pump = Node(80, 80, "Pump");
        var motor = Node(80, 240, "Motor");
        var tank = Node(420, 80, "Tank");
        var level = Node(420, 240, "Level");

        #region nest
        var drive = new GroupModel([pump, motor]);
        var storage = new GroupModel([tank, level]);
        var skid = new GroupModel([drive, storage], new GroupPadding(30));

        Diagram.Groups.Add(drive);
        Diagram.Groups.Add(storage);
        Diagram.Groups.Add(skid);
        #endregion

        Link(motor, PortAlignment.Top, pump, PortAlignment.Bottom);
        Link(pump, PortAlignment.Right, tank, PortAlignment.Left);
        Link(level, PortAlignment.Top, tank, PortAlignment.Bottom);
    }

    private NodeModel Node(double x, double y, string title)
    {
        var node = Diagram.Nodes.Add(new NodeModel(new Point(x, y)) { Title = title });
        foreach (var alignment in new[] { PortAlignment.Top, PortAlignment.Right, PortAlignment.Bottom, PortAlignment.Left })
            node.AddPort(alignment);
        return node;
    }

    private void Link(NodeModel a, PortAlignment from, NodeModel b, PortAlignment to) =>
        Diagram.Links.Add(new LinkModel(a.GetPort(from)!, b.GetPort(to)!) { TargetMarker = LinkMarker.Arrow });
}
