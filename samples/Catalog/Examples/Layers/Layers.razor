@inherits ExampleBase
@attribute [Example("layers", "Layers", ExampleCategory.Layers,
    "Layer is a drawing band: a higher layer is drawn above every lower one. Thin grey signal links sit in layer 0, under the thick process links and the nodes in layer 1. Move the signals to layer 2 and they cross over everything.",
    Order = 1, New = true)]

<div class="example-column">
    <ExampleToolbar>
        <label><input type="checkbox" checked="@_signalsOnTop" @onchange="SetSignalsOnTop" /> Signals on top (layer 2)</label>
    </ExampleToolbar>
    <ExampleCanvas Diagram="Diagram" />
</div>

@code {
    private const int SignalLayer = 0, ProcessLayer = 1, TopLayer = 2;

    private readonly List<LinkModel> _signals = new();
    private bool _signalsOnTop;

    protected override void OnInitialized()
    {
        Diagram.Options.Links.DefaultRouter = new OrthogonalRouter();
        Diagram.Options.Links.DefaultPathGenerator = new StraightPathGenerator();

        var pump = Node(60, 130, "Pump");
        var tank = Node(660, 130, "Tank");
        var plc = Node(360, 20, "PLC");
        var valve = Node(300, 330, "Valve");
        var gauge = Node(440, 330, "Gauge");

        Link(pump, PortAlignment.Right, tank, PortAlignment.Left, process: true);
        Link(plc, PortAlignment.Bottom, valve, PortAlignment.Top, process: false);
        Link(plc, PortAlignment.Bottom, gauge, PortAlignment.Top, process: false);
        Link(plc, PortAlignment.Left, pump, PortAlignment.Top, process: false);
        Link(plc, PortAlignment.Right, tank, PortAlignment.Top, process: false);
    }

    private void SetSignalsOnTop(ChangeEventArgs e)
    {
        _signalsOnTop = (bool)e.Value!;
        foreach (var signal in _signals)
            signal.Layer = _signalsOnTop ? TopLayer : SignalLayer;
    }

    private NodeModel Node(double x, double y, string title)
    {
        var node = Diagram.Nodes.Add(new NodeModel(new Point(x, y)) { Title = title, Layer = ProcessLayer });
        foreach (var alignment in new[] { PortAlignment.Top, PortAlignment.Right, PortAlignment.Bottom, PortAlignment.Left })
            node.AddPort(alignment);
        return node;
    }

    private void Link(NodeModel a, PortAlignment from, NodeModel b, PortAlignment to, bool process)
    {
        #region layer
        var link = new LinkModel(a.GetPort(from)!, b.GetPort(to)!)
        {
            Color = process ? "#2471a3" : "#9aa3a7",
            Width = process ? 8 : 1.5,
            Layer = process ? ProcessLayer : SignalLayer,
        };
        #endregion
        if (!process)
            _signals.Add(link);
        Diagram.Links.Add(link);
    }
}
