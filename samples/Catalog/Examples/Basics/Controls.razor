@inherits ExampleBase
@using Catalog.Examples.Basics
@using Flow.Diagrams.Core.Controls
@using Flow.Diagrams.Core.Controls.Default
@using Flow.Diagrams.Core.Positions
@attribute [Example("controls", "Controls", ExampleCategory.Basics,
    "Controls are handles drawn next to a model while it is selected. Select a node: a boundary, a remove button and a custom button that adds a child. Select a link: drag either arrowhead to reconnect that end, or remove the link.",
    Order = 13)]

<ExampleCanvas Diagram="Diagram" />

@code {
    protected override void OnInitialized()
    {
        #region register
        Diagram.RegisterComponent<ControlsAddChild, ControlsAddChildWidget>();
        #endregion

        var a = Node(60, 60, "A");
        var b = Node(340, 60, "B");
        var c = Node(200, 240, "C");
        Link(a, PortAlignment.Right, b, PortAlignment.Left);
        Link(a, PortAlignment.Bottom, c, PortAlignment.Left);

        foreach (var node in Diagram.Nodes)
            ControlsExample.AddNodeControls(Diagram, node);
    }

    private NodeModel Node(double x, double y, string title)
    {
        var node = Diagram.Nodes.Add(new NodeModel(new Point(x, y)) { Title = title });
        foreach (var alignment in new[] { PortAlignment.Top, PortAlignment.Right, PortAlignment.Bottom, PortAlignment.Left })
            node.AddPort(alignment);
        return node;
    }

    private void Link(NodeModel from, PortAlignment fromSide, NodeModel to, PortAlignment toSide)
    {
        var link = Diagram.Links.Add(new LinkModel(from.GetPort(fromSide)!, to.GetPort(toSide)!) { TargetMarker = LinkMarker.Arrow });
        #region link
        Diagram.Controls.AddFor(link)
            .Add(new ArrowHeadControl(source: true))
            .Add(new ArrowHeadControl(source: false))
            .Add(new RemoveControl(new LinkPathPositionProvider(0.5)));
        #endregion
    }
}
