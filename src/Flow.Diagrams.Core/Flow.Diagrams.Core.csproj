<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Rodolfo Ochoa, zHaytam</Authors>
    <Description>A fully customizable and extensible all-purpose diagrams library for Blazor</Description>
    <AssemblyVersion>3.0.4.1</AssemblyVersion>
    <FileVersion>3.0.4.1</FileVersion>
    <RepositoryUrl>https://github.com/Rod-O/Flow.Diagrams</RepositoryUrl>
    <Version>3.0.4.1</Version>
    <PackageId>Flow.Diagrams.Core</PackageId>
    <PackageTags>blazor diagrams diagramming svg drag</PackageTags>
    <Product>Flow.Diagrams.Core</Product>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/Rod-O/Flow.Diagrams</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SvgPathProperties" />
  </ItemGroup>

</Project>
