<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Rodolfo Ochoa, zHaytam</Authors>
    <Description>SVG-first diagram library for Blazor: nodes, ports, links and groups, obstacle-avoiding routing, layers, crossing halos and SVG export.</Description>
    <RepositoryUrl>https://github.com/Rod-O/Flow.Diagrams</RepositoryUrl>
    <PackageId>Flow.Diagrams.Core</PackageId>
    <PackageTags>blazor diagrams diagramming svg drag</PackageTags>
    <Product>Flow.Diagrams.Core</Product>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/Rod-O/Flow.Diagrams</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SvgPathProperties" />
  </ItemGroup>

</Project>
