@* Centred on the label's position. The first text is a halo in the background colour that keeps the label readable
   across lines without measuring it for a box; it is a separate element because SVG-to-PDF converters such as
   Svg.Skia ignore paint-order. No font-family: the text inherits it like node text, from the page CSS on screen and from
   SvgExportOptions.FontFamily on the exported document's root. *@
<text class="diagram-link-label-halo"
      text-anchor="middle"
      dominant-baseline="central"
      font-size="12"
      fill="none"
      stroke="@BlazorDiagram.Options.Links.HaloColor"
      stroke-width="4"
      stroke-linejoin="round"
      pointer-events="none">@Label.Content</text>
<text text-anchor="middle"
      dominant-baseline="central"
      font-size="12"
      fill="@BlazorDiagram.Options.Links.DefaultColor"
      pointer-events="none">@Label.Content</text>

@code {

    /// <summary>The diagram, whose link options supply the text and halo colors.</summary>
    [CascadingParameter]
    public BlazorDiagram BlazorDiagram { get; set; } = null!;

    /// <summary>The label to draw; its <c>Content</c> is shown as text. Required.</summary>
    [Parameter]
    public LinkLabelModel Label { get; set; } = null!;

}
